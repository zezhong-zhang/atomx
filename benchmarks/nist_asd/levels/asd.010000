<script type="text/javascript">//<![CDATA[

function setFocus() {
  var de = document.getElementById("de");
  var idsSp = document.getElementById("ids_sp");
  var dom = document.domain;
  var href = document.location.href;
  if ( href.match(/^http:\/\/ekron\.nist\.gov\/ASD\/DataEntry\/.*/i) ) {
    de.value = 1;
  }
  if ( dom.match(/^ekron\.nist\.gov$/i) ) {
    idsSp.style.display="inline";
  }
  document.levels.spectrum.disabled = true;
}
function submit_update() {
  var submitRetrieve = document.getElementById("submit_retrieve");
  var spCrit = document.getElementById("spectrum_crit");
  if ( (spCrit != null) && (submitRetrieve != null) ) {
    var spPrev = spCrit.innerHTML;
    spPrev = spPrev.toLowerCase().replace(/  /gm,"");
    spPrev = spPrev.replace(/<b>/gm,"");
    spPrev = spPrev.replace(/<\/b>/gm,"");
    var sp = document.getElementById("spectrum").value;
    sp = sp.toLowerCase().replace(/  /gm,"");
    if ( sp != spPrev ) {
      submitRetrieve.value = "Update Criteria";
    } else {
        document.levels.spectrum.disabled = false;
      submitRetrieve.value = "Retrieve Data";
    }
  }
  return true;
}

//]]></script>

[Unit]
Description=Atomx receipt-triggered bounded atomic calculation

[Service]
Type=oneshot
WorkingDirectory=/home/zzhang/code/atomx
ExecStart=/usr/bin/python3 /home/zzhang/code/atomx/docs/atomx_hourly_progress_2026_10_10/iteration_worker.py --config /home/zzhang/.local/state/atomx-lark-hourly-aisi-codex/config.json
TimeoutStartSec=45min
MemoryMax=14G
CPUQuota=300%
Nice=10
KillMode=control-group
UMask=0077

SetAtom('Ne')
SetSE(0)
SetVP(0)
SetMS(0,0)
SetBreit(0)
SetRadialGrid(3200,1.0241136890844451,200,-1)
SetOption('radial:scfeps',1e-9)
Config('1s1 2s2 2p6',group='initial')
Config('1s2 2p6',group='final_2s_2s')
Config('1s2 2s1 2p5',group='final_2s_2p')
Config('1s2 2s2 2p4',group='final_2p_2p')
ConfigEnergy(0)
OptimizeRadial(['initial'])
ConfigEnergy(1)
Structure('levels.b',['initial'])
Structure('levels.b',['final_2s_2s'])
Structure('levels.b',['final_2s_2p'])
Structure('levels.b',['final_2p_2p'])
MemENTable('levels.b')
PrintTable('levels.b','levels.txt',1)
AITable('ai.b',['initial'],['final_2s_2s', 'final_2s_2p', 'final_2p_2p'])
PrintTable('ai.b','ai.txt',1)
Reinit(0)

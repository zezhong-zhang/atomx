SetVP(0)
SetMS(0,0)
SetBreit(0)
SetRadialGrid(3200,1.0241136890844451,200,-1)
SetOption('radial:scfeps',1e-9)
Config('1s2 2s2 2p5 3s2 3p6 3d10 4s2 4p6',group='initial')
Config('1s1 2s2 2p6 3s2 3p6 3d10 4s2 4p6',group='r_1s')
Config('1s2 2s1 2p6 3s2 3p6 3d10 4s2 4p6',group='r_2s')
Config('1s2 2s2 2p6 3s1 3p6 3d10 4s2 4p6',group='r_3s')
Config('1s2 2s2 2p6 3s2 3p5 3d10 4s2 4p6',group='r_3p')
Config('1s2 2s2 2p6 3s2 3p6 3d9 4s2 4p6',group='r_3d')
Config('1s2 2s2 2p6 3s2 3p6 3d10 4s1 4p6',group='r_4s')
Config('1s2 2s2 2p6 3s2 3p6 3d10 4s2 4p5',group='r_4p')

+@dataclass(frozen=True)
+class DysonRoot:
+    """DF-connected scalar root in an unchanged frozen-orbital reference."""
+
+    energy_Ha: float
+    shift_Ha: float
+    residue: float
+    residual_Ha: float
+    bracket_Ha: tuple[float, float]

InitializeMPI(8)
MPIRank()
WallTime('initialized',0)
LimitArray(0,0)
SetAtom('Xe',54,-1,0)
SetSE(0)
SetVP(0)
SetMS(0,0)
SetBreit(0)
SetRadialGrid(8000,1.0241136890844451,200,-1)
SetOption('orbital:enerelerr',9.9999999999999998e-13)
SetOption('orbital:enerelerr1',9.9999999999999998e-13)
SetOption('orbital:eneabserr',9.9999999999999998e-13)
SetOptimizeTolerance(1e-4)
SetOptimizeMaxIter(150)
SetOptimizePrint(1)
Closed('1s')
Config('gnd','2s2 2p6')
Config('up3s','2s2 2p5 3s1')
Config('up3d','2s2 2p5 3d1')
SetConfigEnergyMode(-1)
OptimizeRadial(['gnd'])
WallTime('ground_scf',0)
Structure('levels.b','gnd.ham',['gnd'])
WallTime('CI_gnd',0)
Structure('levels.b','up3s.ham',['up3s'])
WallTime('CI_up3s',0)
Structure('levels.b','up3d.ham',['up3d'])
WallTime('CI_up3d',0)
MemENTable('levels.b')
PrintTable('levels.b','levels.txt',1)
WallTime('export_levels',0)
SetTransitionCut(0)
SetTransitionOptions(2,1)
TRTable('lines.b',[0],[1],-1)
TRTable('lines.b',[0],[2],-1)
TRTable('lines.b',[0],[3],-1)

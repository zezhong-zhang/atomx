+static int PDumpPhoton(int argc, char *argv[], int argt[], ARRAY *variables) {
+  if (argc != 7) return -1;
+  int n0=atoi(argv[1]), k0=atoi(argv[2]), n1=atoi(argv[3]), k1=atoi(argv[4]);
+  int a=OrbitalIndex(n0,k0,0.0), b=OrbitalIndex(n1,k1,0.0);
+  int m=atoi(argv[5]), gauge=atoi(argv[6]);
+  double omega=GetOrbital(b)->energy-GetOrbital(a)->energy;
+  double aw=omega*FINE_STRUCTURE_CONST;
+  FreeMultipoleArray();
+  SetAWGrid(1,aw,aw);
+  double value=MultipoleRadialFR(aw,m,a,b,gauge), ga;
+  double gf=OscillatorStrength(m,omega,value,&ga);
+  FILE *fp=fopen(argv[0],"a");
+  if (!fp) return -1;
+  fprintf(fp,"%d %d %d %d %d %d %.17g %.17g %.17g %.17g\n",
+          n0,k0,n1,k1,m,gauge,omega,value,gf,ga*RATE_AU/(2*abs(k1)));
+  fclose(fp);
+  return 0;
+}

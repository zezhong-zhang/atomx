+static int PDumpBreitElement(int argc, char *argv[], int argt[], ARRAY *variables) {
+  if (argc != 14) return -1;
+  int idx[4],kap[4],jj[4],ll[4],mm[4];
+  for (int i=0;i<4;i++) {
+    kap[i]=atoi(argv[2+3*i]);
+    mm[i]=atoi(argv[3+3*i]);
+    jj[i]=2*abs(kap[i])-1;
+    ll[i]=2*(kap[i]>0?kap[i]:-kap[i]-1);
+    idx[i]=OrbitalIndex(atoi(argv[1+3*i]),kap[i],0.0);
+  }
+  int q=mm[0]-mm[2],mode=atoi(argv[13]);
+  double value=0.0;
+  for (int k=0;k<=(jj[0]+jj[2])/2;k++) {
+    double angular=W3j(jj[0],2*k,jj[2],-mm[0],q,mm[2])*
+                   W3j(jj[1],2*k,jj[3],-mm[1],-q,mm[3])*
+                   ReducedCL(jj[0],2*k,jj[2])*ReducedCL(jj[1],2*k,jj[3]);
+    if (((jj[0]-mm[0]+jj[1]-mm[1]+q)/2)%2) angular=-angular;
+    value+=angular*Breit(idx[0],idx[1],idx[2],idx[3],k,
+                        kap[0],kap[1],kap[2],kap[3],ll[0],ll[1],ll[2],ll[3],mode);
+  }
+  FILE *fp=fopen(argv[0],"a");
+  if (!fp) return -1;
+  for(int i=1;i<14;i++) fprintf(fp,"%s ",argv[i]);
+  fprintf(fp,"%.17g\n",value);
+  fclose(fp);
+  return 0;
+}

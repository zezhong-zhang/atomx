+static int PDumpBreitPair(int argc, char *argv[], int argt[], ARRAY *variables) {
+  if (argc != 6) return -1;
+  int na=atoi(argv[1]), ka=atoi(argv[2]), nb=atoi(argv[3]), kb=atoi(argv[4]);
+  int ia=OrbitalIndex(na,ka,0.0), ib=OrbitalIndex(nb,kb,0.0);
+  int ja=2*abs(ka)-1, jb=2*abs(kb)-1;
+  int la=2*(ka>0 ? ka : -ka-1), lb=2*(kb>0 ? kb : -kb-1);
+  int mode=atoi(argv[5]);
+  double sum=0.0;
+  for (int k=abs(ja-jb)/2; k<=(ja+jb)/2; k++) {
+    double w=W3j(ja,2*k,jb,-1,0,1);
+    sum-= (ja+1.0)*(jb+1.0)*w*w*
+      Breit(ia,ib,ib,ia,k,ka,kb,kb,ka,la,lb,lb,la,mode);
+  }
+  FILE *fp=fopen(argv[0],"a");
+  if (!fp) return -1;
+  fprintf(fp,"%d %d %d %d %d %.17g %.17g %.17g\n",na,ka,nb,kb,mode,
+          GetOrbital(ia)->energy,GetOrbital(ib)->energy,sum);
+  fclose(fp);
+  return 0;
+}

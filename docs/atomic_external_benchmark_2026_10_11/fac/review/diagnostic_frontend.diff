+static int PDumpSpinor(int argc, char *argv[], int argt[], ARRAY *variables) {
+  if (argc != 3) return -1;
+  ORBITAL *o=GetOrbitalSolved(OrbitalIndex(atoi(argv[1]),atoi(argv[2]),0.0));
+  POTENTIAL *p=RadialPotential();
+  FILE *fp=fopen(argv[0],"w");
+  if (!fp || !o || !o->wfun) return -1;
+  fprintf(fp,"# n=%d kappa=%d energy_Ha=%.17g ilast=%d alpha=%.17g\n",o->n,o->kappa,o->energy,o->ilast,FINE_STRUCTURE_CONST);
+  for (int i=0;i<p->maxrp;i++)
+    fprintf(fp,"%.17g %.17g %.17g %.17g\n",p->rad[i],
+            i<=o->ilast?o->wfun[i]:0.0,i<=o->ilast?o->wfun[p->maxrp+i]:0.0,p->dr_drho[i]);
+  fclose(fp);
+  return 0;
+}

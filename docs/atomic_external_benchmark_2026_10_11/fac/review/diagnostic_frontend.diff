+static int PDumpCI1E(int argc, char *argv[], int argt[], ARRAY *variables) {
+  if (argc != 6) return -1;
+  int a=OrbitalIndex(atoi(argv[2]),atoi(argv[3]),0.0);
+  int c=OrbitalIndex(atoi(argv[4]),atoi(argv[5]),0.0);
+  ORBITAL *oa=GetOrbitalSolved(a), *oc=GetOrbitalSolved(c);
+  if (!oa || !oc) return -1;
+  double residual=0.0;
+  if (ResidualPotential(&residual,a,c)<0) return -1;
+  FILE *fp=fopen(argv[0],"a");
+  if (!fp) return -1;
+  fprintf(fp,"%s %.17g %.17g %.17g\n",argv[1],residual+(a==c?oa->energy:0.0),residual,(a==c?oa->energy:0.0));
+  fclose(fp);
+  return 0;
+}
+static int PDumpCIRK(int argc, char *argv[], int argt[], ARRAY *variables) {
+  if (argc != 11) return -1;
+  int indices[4];
+  for (int i=0;i<4;i++)
+    indices[i]=OrbitalIndex(atoi(argv[2+2*i]),atoi(argv[3+2*i]),0.0);
+  double value=0.0;
+  if (Slater(&value,indices[0],indices[1],indices[2],indices[3],atoi(argv[10]),0)<0) return -1;
+  FILE *fp=fopen(argv[0],"a");
+  if (!fp) return -1;
+  fprintf(fp,"%s %.17g\n",argv[1],value);
+  fclose(fp);
+  return 0;
+}

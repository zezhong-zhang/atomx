+static int PDumpVinti(int argc, char *argv[], int argt[], ARRAY *variables) {
+  if (argc != 5) return -1;
+  int a = OrbitalIndex(atoi(argv[1]), atoi(argv[2]), 0.0);
+  int b = OrbitalIndex(atoi(argv[3]), atoi(argv[4]), 0.0);
+  double *v = Vinti(a,b);
+  if (!v) return -1;
+  FILE *fp = fopen(argv[0], "a");
+  if (!fp) return -1;
+  fprintf(fp, "%s %s %s %s %.17g %.17g %.17g\n", argv[1], argv[2], argv[3], argv[4], v[0], v[1], v[2]);
+  fclose(fp);
+  return 0;
+}

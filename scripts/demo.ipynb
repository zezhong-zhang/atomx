    "from atomx import Atom\n",
    "\n",
    "# Neutral cobalt with default Dirac-Fock SCF\n",
    "atom = Atom(Z=82,qed=True, breit=True, exchange=\"hf\", numerics=\"shooting\",averaging='ci')\n",
